{
  "manifest_version": 3,
  "name": "Reply Copilot",
  "version": "0.17.0",
  "description": "发现 Reddit / X / LinkedIn / Hacker News 上你感兴趣的讨论，用你的风格起草回复，由你确认后发送。",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "tabs",
    "clipboardWrite",
    "scripting",
    "notifications",
    "contextMenus",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.linkedin.com/*",
    "https://news.ycombinator.com/*",
    "https://hn.algolia.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "打开 Reply Copilot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "content/common.js",
        "content/reddit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content/common.js",
        "content/x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/common.js",
        "content/linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://news.ycombinator.com/*"
      ],
      "js": [
        "content/common.js",
        "content/hn.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-reply": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "帮我回复：用剪贴板里的文字生成回复建议",
      "global": true
    },
    "quick-translate": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "翻译润色：用剪贴板里的文字",
      "global": true
    }
  }
}